{
  "name": "@broville/media-search-mcp",
  "version": "2.0.0",
  "description": "MCP server for movie and TV show search via Radarr / Sonarr / TVmaze — zero TMDB/TVDB keys required",
  "main": "dist/index.js",
  "type": "module",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/inject-shebang.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "radarr",
    "sonarr",
    "tvmaze",
    "movies",
    "tv-shows",
    "search",
    "keyless"
  ],
  "author": "Broville <neo@eaglepass.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Broville/media_search_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Broville/media_search_mcp/issues"
  },
  "homepage": "https://github.com/Broville/media_search_mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
